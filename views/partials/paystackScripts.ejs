<!-- Global Paystack Error Suppression Script -->
<script>
(function() {
    'use strict';
    
    // Store original console methods
    const originalError = console.error;
    const originalWarn = console.warn;
    const originalLog = console.log;
    
    // Override console.error
    console.error = function(...args) {
        const message = args[0];
        if (typeof message === 'string' && (
            message.includes('button.min.css') ||
            message.includes('paystack.com') ||
            message.includes('ERR_BLOCKED_BY_RESPONSE') ||
            message.includes('NotSameOrigin') ||
            message.includes('403 (Forbidden)') ||
            message.includes('net::ERR_BLOCKED_BY_RESPONSE') ||
            message.includes('Refused to load the stylesheet') ||
            message.includes('violates the following Content Security Policy') ||
            message.includes('checkout.paystack.com')
        )) {
            // Suppress Paystack-related errors
            return;
        }
        originalError.apply(console, args);
    };
    
    // Override console.warn
    console.warn = function(...args) {
        const message = args[0];
        if (typeof message === 'string' && (
            message.includes('button.min.css') ||
            message.includes('paystack.com') ||
            message.includes('ERR_BLOCKED_BY_RESPONSE') ||
            message.includes('NotSameOrigin') ||
            message.includes('Refused to load the stylesheet') ||
            message.includes('violates the following Content Security Policy') ||
            message.includes('checkout.paystack.com')
        )) {
            // Suppress Paystack-related warnings
            return;
        }
        originalWarn.apply(console, args);
    };
    
    // Override fetch to prevent CSS requests
    const originalFetch = window.fetch;
    window.fetch = function(url, options) {
        if (typeof url === 'string' && (
            url.includes('button.min.css') ||
            url.includes('paystack.com/public/css/')
        )) {
            // Return a rejected promise to prevent the request
            return Promise.reject(new Error('CSS request blocked by Luno'));
        }
        return originalFetch.apply(this, arguments);
    };
    
    // Override XMLHttpRequest to prevent CSS requests
    const originalXHROpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(method, url, ...args) {
        if (typeof url === 'string' && (
            url.includes('button.min.css') ||
            url.includes('paystack.com/public/css/')
        )) {
            // Block the request
            throw new Error('CSS request blocked by Luno');
        }
        return originalXHROpen.apply(this, [method, url, ...args]);
    };
    
    // Global error handler
    window.addEventListener('error', function(e) {
        if (e.message && (
            e.message.includes('button.min.css') ||
            e.message.includes('paystack.com') ||
            e.message.includes('ERR_BLOCKED_BY_RESPONSE') ||
            e.message.includes('Refused to load the stylesheet') ||
            e.message.includes('violates the following Content Security Policy') ||
            e.message.includes('checkout.paystack.com')
        )) {
            e.preventDefault();
            return false;
        }
    });
    
    // Unhandled promise rejection handler
    window.addEventListener('unhandledrejection', function(e) {
        if (e.reason && e.reason.message && (
            e.reason.message.includes('button.min.css') ||
            e.reason.message.includes('paystack.com') ||
            e.reason.message.includes('ERR_BLOCKED_BY_RESPONSE') ||
            e.reason.message.includes('Refused to load the stylesheet') ||
            e.reason.message.includes('violates the following Content Security Policy') ||
            e.reason.message.includes('checkout.paystack.com')
        )) {
            e.preventDefault();
            return false;
        }
    });
})();
</script>

