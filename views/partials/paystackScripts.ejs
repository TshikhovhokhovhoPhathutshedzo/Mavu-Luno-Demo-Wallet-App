}

// Function to show biometric verification modal (kept for compatibility)
function showBiometricModal(availablePatterns, transactionType, transactionData) {
    // Create modal HTML
    const modalHTML = `
        <div id="biometric-modal" class="modal" style="display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;">
            <div class="box" style="background: white; padding: 20px; border-radius: 10px; max-width: 400px; width: 90%; max-height: 80vh; overflow-y: auto;">
                <h2>Biometric Verification Required</h2>
                <p>Please verify your identity using your behavioral pattern to complete this ${transactionType}.</p>
                
                <div class="pattern-selection" style="margin: 20px 0;">
                    <label>Select Pattern Type:</label>
                    <select id="biometric-pattern-type" style="width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ddd; border-radius: 5px;">
                        ${availablePatterns.map(pattern => `<option value="${pattern}">${pattern.charAt(0).toUpperCase() + pattern.slice(1)} Pattern</option>`).join('')}
                    </select>
                </div>

                <div class="pattern-drawing" style="margin: 20px 0;">
                    <label>Draw your pattern:</label>
                    <canvas id="biometric-canvas" width="300" height="200" style="border: 2px solid #ddd; border-radius: 5px; margin: 10px 0; cursor: crosshair;"></canvas>
                    <div style="text-align: center; margin: 10px 0;">
                        <button id="clear-biometric-canvas" style="padding: 8px 16px; margin: 0 5px; background: #f0f0f0; border: 1px solid #ddd; border-radius: 5px; cursor: pointer;">Clear</button>
                        <button id="submit-biometric-pattern" style="padding: 8px 16px; margin: 0 5px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">Verify Pattern</button>
                    </div>
                </div>

                <div id="biometric-error" style="color: red; margin: 10px 0; display: none;"></div>

                <div style="text-align: center; margin-top: 20px;">
                    <button id="cancel-biometric" style="padding: 10px 20px; background: #dc3545; color: white; border: none; border-radius: 5px; cursor: pointer;">Cancel</button>
                </div>
            </div>
        </div>
    `;

    // Add modal to page
    document.body.insertAdjacentHTML('beforeend', modalHTML);

    // Initialize biometric canvas
    initializeBiometricCanvas();
    
    // Store transaction data
    window.currentTransactionData = { type: transactionType, data: transactionData };

    // Add event listeners
    document.getElementById('cancel-biometric').addEventListener('click', closeBiometricModal);
    document.getElementById('clear-biometric-canvas').addEventListener('click', clearBiometricCanvas);
    document.getElementById('submit-biometric-pattern').addEventListener('click', submitBiometricPattern);
    document.getElementById('biometric-pattern-type').addEventListener('change', function() {
        selectedBiometricType = this.value;
    });
}

// Initialize biometric canvas
function initializeBiometricCanvas() {
    biometricCanvas = document.getElementById('biometric-canvas');
    biometricCtx = biometricCanvas.getContext('2d');
    selectedBiometricType = document.getElementById('biometric-pattern-type').value;
    
    // Set canvas style
    biometricCtx.strokeStyle = '#007bff';
    biometricCtx.lineWidth = 3;
    biometricCtx.lineCap = 'round';

    // Add event listeners
    biometricCanvas.addEventListener('mousedown', startBiometricDrawing);
    biometricCanvas.addEventListener('mousemove', drawBiometric);
    biometricCanvas.addEventListener('mouseup', stopBiometricDrawing);
    biometricCanvas.addEventListener('touchstart', handleBiometricTouch);
    biometricCanvas.addEventListener('touchmove', handleBiometricTouch);
    biometricCanvas.addEventListener('touchend', stopBiometricDrawing);
}

// Biometric drawing functions
function startBiometricDrawing(e) {
    e.preventDefault();
    isDrawingBiometric = true;
    currentBiometricPattern = [];
    const point = getBiometricCanvasPoint(e);
    currentBiometricPattern.push(point);
    biometricCtx.beginPath();
    biometricCtx.moveTo(point.x, point.y);
}

function drawBiometric(e) {
    e.preventDefault();
    if (!isDrawingBiometric) return;
    
    const point = getBiometricCanvasPoint(e);
    currentBiometricPattern.push(point);
    biometricCtx.lineTo(point.x, point.y);
    biometricCtx.stroke();
}

function stopBiometricDrawing() {
    isDrawingBiometric = false;
    if (currentBiometricPattern && currentBiometricPattern.length > 0) {
        biometricPatternAttempts = [currentBiometricPattern];
    }
}

function handleBiometricTouch(e) {
    e.preventDefault();
    if (e.type === 'touchstart') {
        startBiometricDrawing(e.touches[0]);
    } else if (e.type === 'touchmove') {
        drawBiometric(e.touches[0]);
    }
}

function getBiometricCanvasPoint(e) {
    const rect = biometricCanvas.getBoundingClientRect();
    return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
        timestamp: Date.now(),
        pressure: e.pressure || 0.5
    };
}

function clearBiometricCanvas() {
    biometricCtx.clearRect(0, 0, biometricCanvas.width, biometricCanvas.height);
    currentBiometricPattern = [];
    biometricPatternAttempts = [];
}

function closeBiometricModal() {
    const modal = document.getElementById('biometric-modal');
    if (modal) {
        modal.remove();
    }
    biometricCanvas = null;
    biometricCtx = null;
    currentBiometricPattern = null;
    biometricPatternAttempts = [];
}

// Submit biometric pattern for verification
async function submitBiometricPattern() {
    if (!currentBiometricPattern || currentBiometricPattern.length < 5) {
        showBiometricError('Please draw a complete pattern (at least 5 points)');
        return;
    }

    const patternData = {
        coordinates: currentBiometricPattern.map(p => [p.x, p.y]),
        timing: calculateBiometricTiming(currentBiometricPattern),
        pressure: currentBiometricPattern.map(p => p.pressure || 0.5)
    };

    const biometricData = {
        patternType: selectedBiometricType,
        patternData: patternData
    };

    try {
        const transactionData = window.currentTransactionData;
        let response;

        if (transactionData.type === 'deposit') {
            response = await fetch('/api/verify-deposit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    ...transactionData.data,
                    biometricPattern: biometricData
                })
            });
        } else if (transactionData.type === 'withdrawal') {
            response = await fetch('/api/withdraw', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    ...transactionData.data,
                    biometricPattern: biometricData
                })
            });
        }

        const data = await response.json();

        if (data.success) {
            // Update balance in real-time
            if (typeof updateBalance === 'function') {
                if (transactionData.type === 'deposit') {
                    updateBalance(data.amount);
                } else {
                    updateBalance(data.balance);
                }
            }
            
            closeBiometricModal();
            if (transactionData.type === 'deposit') {
                window.location.href = `/?message=${encodeURIComponent(data.message)}&amount=${data.amount}&display=block`;
            } else {
                window.location.href = `/?message=${encodeURIComponent(data.message)}&display=block`;
            }
        } else {
            showBiometricError(data.message || 'Pattern verification failed. Please try again.');
        }
    } catch (error) {
        console.error('Biometric verification error:', error);
        showBiometricError('Error during verification. Please try again.');
    }
}

function calculateBiometricTiming(pattern) {
    const timings = [];
    for (let i = 1; i < pattern.length; i++) {
        timings.push(pattern[i].timestamp - pattern[i-1].timestamp);
    }
    return timings;
}

function showBiometricError(message) {
    const errorDiv = document.getElementById('biometric-error');
    errorDiv.textContent = message;
    errorDiv.style.display = 'block';
}
</script>