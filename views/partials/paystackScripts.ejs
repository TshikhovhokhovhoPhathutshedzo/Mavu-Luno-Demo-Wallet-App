              if (typeof PaystackPop !== 'undefined' && window.paystackReady) {
                clearInterval(checkPaystack);
                window.payWithPaystack(userEmail); // Retry
              }
            }, 100);
            
            // Timeout after 5 seconds
            setTimeout(() => {
              clearInterval(checkPaystack);
              if (typeof PaystackPop === 'undefined' || !window.paystackReady) {
                alert('Payment service failed to load. Please refresh the page and try again.');
              }
            }, 5000);
            
            return;
          }

