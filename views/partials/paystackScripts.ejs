          if (method === 'paystack') {
            checkAnomalyBeforePaystack();
          }
        });
        
        async function checkAnomalyBeforePaystack() {
          const amount = parseFloat(document.getElementById('deposit-amount').value);
        
          if (!amount || amount <= 0) {
            return;
          }
        
          try {
            // First check daily limits using the limit manager
            console.log('Checking daily limits for deposit:', { amount });
            
            if (window.limitManager) {
              const limitCheck = await window.limitManager.checkTransactionLimit('deposit', amount);
              console.log('Daily limits check result:', limitCheck);

              if (!limitCheck.allowed) {
                // Daily limit exceeded - handled by new notification system
                return;
              }
            } else {
              // Fallback to API call if limit manager not available
              console.log('Limit manager not available, using API fallback');
              const limitsResponse = await fetch('/api/check-deposit-limits', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  amount: amount
                })
              });

              const limitsData = await limitsResponse.json();
              console.log('Daily limits check result:', limitsData);

              if (!limitsData.success || limitsData.limitExceeded) {
                // Daily limit exceeded - handled by new notification system
                return;
              }
            }

            // Daily limits check passed, now check for anomalies
            console.log('Daily limits check passed, checking anomalies with:', { amount });
            const response = await fetch('/api/check-anomalies', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                amount: amount
              })
            });

            console.log('Response status:', response.status);
            console.log('Response headers:', response.headers);
            
            const data = await response.json();
            console.log('Response data:', data);

            if (data.success) {
              // No anomalies detected, proceed to Paystack
              payWithPaystack(data.userEmail);
            } else if (data.requiresVerification) {
              // Anomalies detected, show verification modal
              showAnomalyVerificationModal(data.anomalies, 'deposit', { amount, userEmail: data.userEmail });
            } else if (data.message && data.message.includes('not authenticated')) {
              // Authentication error - redirect to login
              setTimeout(() => {
                window.location.href = '/';
              }, 2000);
            } else if (data.requiresSetup) {
              // Security questions not set up
              setTimeout(() => {
                window.location.href = '/settings';
              }, 3000);
            }
          } catch (error) {
            console.error('Error checking limits/anomalies:', error);
            console.error('Error details:', error.message);
          }
        }
        
        // Make payWithPaystack globally accessible
        window.payWithPaystack = function(userEmail) {
          // Check if PaystackPop is available
          if (typeof PaystackPop === 'undefined' || !window.paystackReady) {
            console.error('PaystackPop is not available. Please check if the Paystack script is loaded.');
            alert('Payment service is loading. Please wait a moment and try again.');
            
            // Wait for PaystackPop to be available
