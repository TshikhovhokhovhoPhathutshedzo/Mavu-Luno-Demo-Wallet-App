<!-- Load Paystack script after DOM is ready -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Load Paystack script dynamically
    const script = document.createElement('script');
    script.src = 'https://js.paystack.co/v1/inline.js';
    script.async = true;
    script.onload = function() {
      console.log('Paystack script loaded successfully');
      // Set a flag to indicate Paystack is ready
      window.paystackReady = true;
    };
    script.onerror = function() {
      console.error('Failed to load Paystack script');
      window.paystackReady = false;
    };
    document.head.appendChild(script);
  });
</script>

<!-- Biometric Verification Functions -->
<script>
// Global variables for biometric verification
let currentBiometricPattern = null;
let biometricCanvas = null;
let biometricCtx = null;
let isDrawingBiometric = false;
let biometricPatternAttempts = [];
let selectedBiometricType = null;

// Function to process deposit after Paystack payment (anomalies already checked)
async function processDepositAfterPayment(reference, amount, email) {
    try {
        const response = await fetch('/api/verify-deposit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reference: reference,
                amount: amount,
                email: email,
                anomalyVerified: true // Mark as already verified
            })
        });

        const data = await response.json();

        if (data.success) {
            // Update balance in real-time
            if (typeof updateBalance === 'function') {
                updateBalance(data.amount);
            }
            
            // Transaction successful
            const message = data.message || 'Deposit successful!';
            window.location.href = `/?message=${encodeURIComponent(message)}&amount=${data.amount}&display=block`;
        } else {
            // Error occurred
            const errorMessage = data.message || data.error || 'Deposit failed. Please try again.';
            console.error('Deposit error:', data);
            window.location.href = `/?message=${encodeURIComponent(errorMessage)}&display=block`;
        }
    } catch (error) {
        console.error('Error processing deposit:', error);
        window.location.href = `/?message=${encodeURIComponent('An error occurred while processing your deposit.')}&display=block`;
    }
}

// Function to check biometric and process deposit (kept for compatibility)
async function checkBiometricAndProcessDeposit(reference, amount, email) {
    try {
        // First, try to process without biometric to see if it's required
        const response = await fetch('/api/verify-deposit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                reference: reference,
                amount: amount,
                email: email
            })
        });

        const data = await response.json();

        if (data.success) {
            // No verification required, transaction successful
            const message = data.message || 'Deposit successful!';
            window.location.href = `/?message=${encodeURIComponent(message)}&amount=${data.amount}&display=block`;
        } else if (data.requiresVerification) {
            // Anomaly verification required
            showAnomalyVerificationModal(data.anomalies, 'deposit', { reference, amount, email });
        } else {
            // Other error
            const errorMessage = data.message || data.error || 'Deposit failed. Please try again.';
            console.error('Deposit error:', data);
            window.location.href = `/?message=${encodeURIComponent(errorMessage)}&display=block`;
        }
    } catch (error) {
        console.error('Error processing deposit:', error);
        window.location.href = `/?message=${encodeURIComponent('An error occurred while processing your deposit.')}&display=block`;
    }
}

// Function to check biometric and process withdrawal
async function checkBiometricAndProcessWithdrawal(amount) {
    try {
        // First check daily limits using the limit manager
        console.log('Checking daily limits for withdrawal:', { amount });
        
        if (window.limitManager) {
            const limitCheck = await window.limitManager.checkTransactionLimit('withdrawal', amount);
            console.log('Daily limits check result:', limitCheck);

            if (!limitCheck.allowed) {
                // Daily limit exceeded, show error
                const responseMessage = document.querySelector('.withdraw-message');
                responseMessage.style.display = 'block';
                responseMessage.innerHTML = limitCheck.reason || 'This withdrawal would exceed your daily limit.';
                if (limitCheck.details) {
                    responseMessage.innerHTML += `<br><small>Used today: R${limitCheck.details.currentUsage.toFixed(2)} | Limit: R${limitCheck.details.dailyLimit.toFixed(2)} | Remaining: R${limitCheck.details.remaining.toFixed(2)}</small>`;
                    responseMessage.innerHTML += `<br><button onclick="window.limitManager.forceRefresh()" style="margin-top: 10px; padding: 5px 10px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">Refresh Limits</button>`;
                }
                
                // Re-enable button
                const withdrawButton = document.querySelector('button[type="submit"]');
                if (withdrawButton) {
                    withdrawButton.disabled = false;
                    withdrawButton.textContent = 'Withdraw Now';
                }
                return;
            }
        } else {
            // Fallback to API call if limit manager not available
            console.log('Limit manager not available, using API fallback');
            const limitsResponse = await fetch('/api/check-withdrawal-limits', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    amount: amount
                })
            });

            const limitsData = await limitsResponse.json();
            console.log('Daily limits check result:', limitsData);

            if (!limitsData.success || limitsData.limitExceeded) {
                // Daily limit exceeded - handled by new notification system
                // Re-enable button
                const withdrawButton = document.querySelector('button[type="submit"]');
                if (withdrawButton) {
                    withdrawButton.disabled = false;
                    withdrawButton.textContent = 'Withdraw Now';
                }
                return;
            }
        }

        // Daily limits check passed, now process withdrawal
        console.log('Daily limits check passed, processing withdrawal');
        const response = await fetch('/api/withdraw', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                amount: amount
            })
        });

        const data = await response.json();

        if (data.success) {
            // Update balance in real-time
            if (typeof updateBalance === 'function') {
                updateBalance(data.balance);
            }
            
            // No verification required, transaction successful
            const message = data.message || 'Withdrawal successful!';
            window.location.href = `/?message=${encodeURIComponent(message)}&display=block`;
        } else if (data.requiresVerification) {
            // Anomaly verification required
            showAnomalyVerificationModal(data.anomalies, 'withdrawal', { amount });
        } else if (data.requiresSetup) {
            // Security questions not set up
            setTimeout(() => {
                window.location.href = '/settings';
            }, 3000);
        } else {
            // Other error - re-enable button
            const withdrawButton = document.querySelector('button[type="submit"]');
            if (withdrawButton) {
                withdrawButton.disabled = false;
                withdrawButton.textContent = 'Withdraw Now';
            }
            console.error('Withdrawal error:', data);
        }
    } catch (error) {
        console.error('Error processing withdrawal:', error);
        
        // Re-enable button on error
        const withdrawButton = document.querySelector('button[type="submit"]');
        if (withdrawButton) {
            withdrawButton.disabled = false;
            withdrawButton.textContent = 'Withdraw Now';
        }
    }
}

// Function to show anomaly verification modal
function showAnomalyVerificationModal(anomalies, transactionType, transactionData) {
    // Initialize the anomaly verification system
    if (window.anomalyVerification) {
        window.anomalyVerification.init();
        window.anomalyVerification.showModal(anomalies, transactionType, transactionData);
    } else {
        console.error('Anomaly verification system not loaded');
