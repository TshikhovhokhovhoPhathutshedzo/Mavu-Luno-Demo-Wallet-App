<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DeepFace Authentication - LunoWallet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1a1a2e;
            --secondary-color: #16213e;
            --accent-color: #0f3460;
            --text-color: #ffffff;
            --border-color: #333;
            --success-color: #28a745;
            --error-color: #dc3545;
            --warning-color: #ffc107;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 30px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            color: var(--text-color);
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .header p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.2em;
        }

        .face-registration-container {
            max-width: 100%;
            margin: 0;
            padding: 0;
            border: none;
            background: transparent;
        }

        .camera-container {
            text-align: center;
            margin: 20px 0;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            padding: 20px;
        }

        .camera-container video {
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
            border: 2px solid var(--accent-color);
        }

        .capture-controls {
            text-align: center;
            margin: 20px 0;
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 24px;
            margin: 5px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .btn-primary { 
            background: linear-gradient(45deg, #007bff, #0056b3); 
            color: white; 
        }
        .btn-success { 
            background: linear-gradient(45deg, #28a745, #1e7e34); 
            color: white; 
        }
        .btn-secondary { 
            background: linear-gradient(45deg, #6c757d, #545b62); 
            color: white; 
        }
        .btn-danger { 
            background: linear-gradient(45deg, #dc3545, #c82333); 
            color: white; 
        }
        .btn-warning { 
            background: linear-gradient(45deg, #ffc107, #e0a800); 
            color: black; 
        }

        .status-success { 
            color: #28a745; 
            font-weight: 600;
        }
        .status-error { 
            color: #dc3545; 
            font-weight: 600;
        }
        .status-info { 
            color: #17a2b8; 
            font-weight: 600;
        }

        .faces-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .face-item {
            text-align: center;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            padding: 15px;
            background: rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .face-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
        }

        .face-thumbnail {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 15px;
            border: 2px solid var(--accent-color);
        }

        .face-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-sm {
            padding: 8px 16px;
            font-size: 12px;
        }

        .info-card {
            background: rgba(23, 162, 184, 0.1);
            border: 1px solid #17a2b8;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
        }

        .info-card h4 {
            color: #17a2b8;
            margin-bottom: 10px;
        }

        .info-card p {
            margin: 5px 0;
            color: rgba(255, 255, 255, 0.9);
        }

        .alert {
            border-radius: 8px;
            margin: 20px 0;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            border: 1px solid #28a745;
            color: #28a745;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid #dc3545;
            color: #dc3545;
        }

        .alert-info {
            background: rgba(23, 162, 184, 0.2);
            border: 1px solid #17a2b8;
            color: #17a2b8;
        }

        .hidden {
            display: none;
        }

        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .capture-controls {
                flex-direction: column;
                align-items: center;
            }
            
            .faces-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-user-circle"></i> DeepFace Authentication</h1>
            <p>Register your face for secure, password-free login</p>
        </div>

        <!-- Flash Messages -->
        <% if (success && success.length > 0) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= success %>
            </div>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <!-- Face Registration Section -->
        <div class="face-registration-container">
            <div class="info-card">
                <h4><i class="fas fa-info-circle"></i> About DeepFace Authentication</h4>
                <p>• Register your face for secure, password-free login</p>
                <p>• Multiple faces can be registered per account</p>
                <p>• Set one face as primary for faster recognition</p>
                <p>• Your face data is encrypted and stored securely</p>
            </div>

            <div class="camera-container">
                <video id="face-capture-video" autoplay muted playsinline style="width: 100%; max-width: 400px; border-radius: 8px;"></video>
                <canvas id="face-capture-canvas" style="display: none;"></canvas>
            </div>

            <div class="capture-controls">
                <button id="start-camera-btn" class="btn btn-primary">
                    <i class="fas fa-video"></i> Start Camera
                </button>
                <button id="capture-face-btn" class="btn btn-success" disabled>
                    <i class="fas fa-camera"></i> Capture Face
                </button>
                <button id="stop-camera-btn" class="btn btn-secondary" disabled>
                    <i class="fas fa-stop"></i> Stop Camera
                </button>
            </div>

            <div class="face-status" id="face-status">
                <p class="status-info">Camera not started</p>
            </div>

            <div class="registered-faces" id="registered-faces">
                <!-- Registered faces will be displayed here -->
            </div>
        </div>

        <!-- Back to Settings -->
        <div class="text-center mt-4">
            <a href="/settings" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Settings
            </a>
        </div>
    </div>

    <!-- Include Face Authentication JavaScript -->
    <script src="/js/face_auth_frontend.js"></script>
    
    <script>
        // Global variables
        let currentUser;

        // Initialize the face registration component
        document.addEventListener('DOMContentLoaded', function() {
            // Set current user data
            currentUser = {
                userId: '<%= user.user_id %>',
                username: '<%= user.username %>',
                email: '<%= user.email %>'
            };

            // Store user data in localStorage for the face auth component
            localStorage.setItem('current_user_id', currentUser.userId);
            localStorage.setItem('current_username', currentUser.username);
            localStorage.setItem('current_email', currentUser.email);

            // Use the global faceAuthManager from face_auth_frontend.js
            // It's already initialized globally in that file

            // Setup camera controls
            setupCameraControls();

            // Load initial face data
            loadFaceAuthStatus();
        });

        // Setup camera controls
        function setupCameraControls() {
            const startBtn = document.getElementById('start-camera-btn');
            const captureBtn = document.getElementById('capture-face-btn');
            const stopBtn = document.getElementById('stop-camera-btn');

            startBtn.addEventListener('click', startCamera);
            captureBtn.addEventListener('click', captureFace);
            stopBtn.addEventListener('click', stopCamera);
        }

        // Start camera
        async function startCamera() {
            try {
                await faceAuthManager.initCamera('face-capture-video', 'face-capture-canvas');
                
                document.getElementById('start-camera-btn').disabled = true;
                document.getElementById('capture-face-btn').disabled = false;
                document.getElementById('stop-camera-btn').disabled = false;
                
                updateStatus('Camera started. Position your face in the frame and click "Capture Face"', 'success');
            } catch (error) {
                updateStatus('Error starting camera: ' + error.message, 'error');
            }
        }

        // Capture face
        async function captureFace() {
            try {
                updateStatus('Capturing face...', 'info');
                
                const imageBlob = await faceAuthManager.captureImage();
                
                const formData = new FormData();
                formData.append('faceImage', imageBlob, 'face.jpg');
                formData.append('is_primary', false);

                const response = await fetch('/deepface-auth/enrollment/enroll', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    updateStatus(`Face registered successfully! ${result.message}`, 'success');
                    loadRegisteredFaces();
                } else {
                    updateStatus('Error: ' + result.message, 'error');
                }
            } catch (error) {
                console.error('Error capturing face:', error);
                if (error.message.includes('Failed to fetch') || error.message.includes('ECONNREFUSED')) {
                    updateStatus('Face authentication service is not available. Please try again later.', 'error');
                } else {
                    updateStatus('Error capturing face: ' + error.message, 'error');
                }
            }
        }

        // Stop camera
        function stopCamera() {
            faceAuthManager.stopCamera();
            
            document.getElementById('start-camera-btn').disabled = false;
            document.getElementById('capture-face-btn').disabled = true;
            document.getElementById('stop-camera-btn').disabled = true;
            
            updateStatus('Camera stopped', 'info');
        }

        // Update status message
        function updateStatus(message, type = 'info') {
            const statusDiv = document.getElementById('face-status');
            statusDiv.innerHTML = `<p class="status-${type}">${message}</p>`;
        }

        // Load registered faces
        async function loadRegisteredFaces() {
            try {
                const response = await fetch('/deepface-auth/faces');
                const result = await response.json();
                
                const facesContainer = document.getElementById('registered-faces');
                
                if (result.success && result.faces && result.faces.length > 0) {
                    facesContainer.innerHTML = `
                        <h4>Registered Faces (${result.faces.length})</h4>
                        <div class="faces-grid">
                            ${result.faces.map((face, index) => `
                                <div class="face-item">
                                    <img src="data:image/jpeg;base64,${face.face_image}" 
                                         alt="Face ${index + 1}" class="face-thumbnail">
                                    <div class="face-actions">
                                        <button onclick="setPrimaryFace(${index})" 
                                                class="btn btn-sm ${face.is_primary ? 'btn-warning' : 'btn-outline'}">
                                            ${face.is_primary ? 'Primary' : 'Set Primary'}
                                        </button>
                                        <button onclick="deleteFace(${index})" 
                                                class="btn btn-sm btn-danger">Delete</button>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    `;
                } else {
                    facesContainer.innerHTML = '<p>No faces registered yet</p>';
                }
            } catch (error) {
                console.error('Error loading registered faces:', error);
            }
        }

        // Set primary face
        async function setPrimaryFace(faceIndex) {
            try {
                const response = await fetch(`/deepface-auth/faces/${faceIndex}/primary`, {
                    method: 'POST'
                });
                const result = await response.json();
                
                if (result.success) {
                    updateStatus('Primary face updated', 'success');
                    loadRegisteredFaces();
                } else {
                    updateStatus('Error: ' + result.message, 'error');
                }
            } catch (error) {
                updateStatus('Error setting primary face: ' + error.message, 'error');
            }
        }

        // Delete face
        async function deleteFace(faceIndex) {
            if (!confirm('Are you sure you want to delete this face?')) return;
            
            try {
                const response = await fetch(`/deepface-auth/faces/${faceIndex}`, {
                    method: 'DELETE'
                });
                const result = await response.json();
                
                if (result.success) {
                    updateStatus('Face deleted', 'success');
                    loadRegisteredFaces();
                } else {
                    updateStatus('Error: ' + result.message, 'error');
                }
            } catch (error) {
                updateStatus('Error deleting face: ' + error.message, 'error');
            }
        }

        // Check face authentication status
        async function loadFaceAuthStatus() {
            try {
                const response = await fetch('/deepface-auth/status');
                const result = await response.json();
                
                if (result.success) {
                    // Update any status elements if they exist
                    console.log('Face auth status:', result);
                } else {
                    console.error('Error loading face auth status:', result.message);
                    updateStatus('Face authentication service is not available. Please try again later.', 'error');
                }
            } catch (error) {
                console.error('Error loading face auth status:', error);
                updateStatus('Face authentication service is not available. Please try again later.', 'error');
            }
        }
    </script>
</body>
</html>
