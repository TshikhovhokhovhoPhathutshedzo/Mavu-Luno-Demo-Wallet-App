    <main class="main">
        <div class="container">
            <div class="scan-container">
            <div class="scan-header">
                <h1>📷 Scan QR Code</h1>
                <p>Point your camera at a QR code to identify the recipient</p>
            </div>

            <div id="scan-status" class="scan-status scanning">
                <p>📷 Camera ready - Position QR code in the frame and click "Capture QR Code"</p>
            </div>

            <div class="camera-container">
                <video id="video" autoplay playsinline></video>
                <canvas id="capture-canvas" style="display: none;"></canvas>
                <div class="camera-overlay"></div>
                <div id="scanning-indicator" class="scanning-indicator" style="display: none;">
                    🔍 Scanning...
                </div>
                <div id="capture-indicator" class="capture-indicator" style="display: none;">
                    📸 Capturing...
                </div>
            </div>

            <div class="upload-instructions">
                <p><small>💡 You can also drag and drop a QR code image here, or use the upload button above</small></p>
            </div>

            <div class="scan-controls">
                <button id="capture-btn" class="btn btn-primary">
                    📷 Capture QR Code
                </button>
                <button id="upload-qr-btn" class="btn btn-secondary">
                    📷 Upload QR Code
                </button>
                <a href="/qr" class="btn btn-secondary">
                    🔗 My QR Code
                </a>
                <a href="/" class="btn btn-secondary">
                    🏠 Back to Dashboard
                </a>
            </div>


            <!-- Hidden file input for QR code upload -->
            <input type="file" id="qr-file-input" accept="image/*" style="display: none;">

            <div id="loading" class="loading">
                <p>🔄 Processing QR code...</p>
            </div>

            <div id="scan-result" class="scan-result">
                <h4>👤 Recipient Found</h4>
                <div class="result-row">
                    <span class="result-label">Name:</span>
                    <span class="result-value" id="recipient-name"></span>
                </div>
                <div class="result-row">
                    <span class="result-label">Username:</span>
                    <span class="result-value" id="recipient-username"></span>
                </div>
                <div class="result-row">
                    <span class="result-label">Account Number:</span>
                    <span class="result-value" id="recipient-account"></span>
                </div>
                <div class="result-row">
                    <span class="result-label">Status:</span>
                    <span class="result-value" id="recipient-status"></span>
                </div>
                <div style="margin-top: 1rem;">
                    <button id="send-payment" class="btn btn-success">
                        💸 Send Payment
                    </button>
                    <button id="scan-another" class="btn btn-secondary">
                        🔄 Scan Another
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qr-scanner/1.4.2/qr-scanner.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const video = document.getElementById('video');
            const scanStatus = document.getElementById('scan-status');
            const captureBtn = document.getElementById('capture-btn');
            const captureCanvas = document.getElementById('capture-canvas');
            const captureIndicator = document.getElementById('capture-indicator');
            const loading = document.getElementById('loading');
            const scanResult = document.getElementById('scan-result');
            const recipientName = document.getElementById('recipient-name');
            const recipientUsername = document.getElementById('recipient-username');
            const recipientAccount = document.getElementById('recipient-account');
            const recipientStatus = document.getElementById('recipient-status');
            const sendPaymentBtn = document.getElementById('send-payment');
            const scanAnotherBtn = document.getElementById('scan-another');
            const uploadQrBtn = document.getElementById('upload-qr-btn');
            const qrFileInput = document.getElementById('qr-file-input');

            let currentRecipient = null;

            // Initialize camera for capture mode
            function initCamera() {
                console.log('Initializing camera for capture mode...');
                
                // Start camera stream
                navigator.mediaDevices.getUserMedia({
                    video: { 
                        facingMode: 'environment',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                }).then(stream => {
                    video.srcObject = stream;
                    video.play();
                    console.log('Camera initialized successfully');
                    
                    // Update status
                    scanStatus.className = 'scan-status scanning';
                    scanStatus.innerHTML = '<p>📷 Camera ready - Click "Capture QR Code" to take a photo</p>';
                }).catch(error => {
                    console.error('Error accessing camera:', error);
                    scanStatus.className = 'scan-status error';
                    
                    if (error.name === 'NotAllowedError') {
                        scanStatus.innerHTML = '<p>❌ Camera access denied. Please allow camera access and try again.</p>';
                    } else if (error.name === 'NotFoundError') {
                        scanStatus.innerHTML = '<p>❌ No camera found. Please check your device has a camera.</p>';
                    } else if (error.name === 'NotSupportedError') {
                        scanStatus.innerHTML = '<p>❌ Camera not supported. Please use a modern browser.</p>';
                    } else {
                        scanStatus.innerHTML = `<p>❌ Camera error: ${error.message}</p>`;
                    }
                });
            }

            // Capture photo and process QR code
            async function captureQRCode() {
                try {
                    console.log('📸 Capturing QR code...');
                    
                    // Show capture indicator
                    captureIndicator.style.display = 'block';
                    captureBtn.disabled = true;
                    captureBtn.textContent = '📸 Capturing...';
                    
                    // Wait a moment for camera to stabilize
                    await new Promise(resolve => setTimeout(resolve, 500));
                    
                    // Set canvas dimensions to match video
                    captureCanvas.width = video.videoWidth;
                    captureCanvas.height = video.videoHeight;
                    
                    // Draw video frame to canvas
                    const context = captureCanvas.getContext('2d');
                    context.drawImage(video, 0, 0, captureCanvas.width, captureCanvas.height);
                    
                    // Get image data
                    const imageData = context.getImageData(0, 0, captureCanvas.width, captureCanvas.height);
                    
                    // Use jsQR to decode the QR code
                    const code = jsQR(imageData.data, imageData.width, imageData.height);
                    
                    if (code) {
                        console.log('✅ QR Code detected in captured image:', code.data);
                        scanStatus.className = 'scan-status success';
                        scanStatus.innerHTML = '<p>✅ QR code detected! Processing...</p>';
                        
                        // Process the QR code data
                        await handleQRResult(code.data);
                    } else {
                        throw new Error('No QR code found in the captured image. Please try again with a clearer QR code.');
                    }
                    
                } catch (error) {
                    console.error('Error capturing QR code:', error);
                    scanStatus.className = 'scan-status error';
                    scanStatus.innerHTML = `<p>❌ ${error.message}</p>`;
                } finally {
                    // Hide capture indicator and reset button
                    captureIndicator.style.display = 'none';
                    captureBtn.disabled = false;
                    captureBtn.textContent = '📷 Capture QR Code';
                }
            }

            // Handle QR code scan result
            async function handleQRResult(qrData) {
                try {
                    console.log('Processing QR code data:', qrData);
                    loading.style.display = 'block';
                    scanStatus.className = 'scan-status';
                    scanStatus.innerHTML = '<p>🔄 Processing QR code...</p>';

                    const response = await fetch('/qr/scan', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ qrData: qrData })
                    });

                    console.log('QR scan response status:', response.status);
                    const data = await response.json();
                    console.log('QR scan response data:', data);

                    if (data.success) {
                        currentRecipient = data.recipient;
                        displayRecipient(data.recipient);
                    } else {
                        throw new Error(data.message || 'Invalid QR code');
                    }
                } catch (error) {
                    console.error('Error processing QR code:', error);
                    scanStatus.className = 'scan-status error';
                    scanStatus.innerHTML = `<p>❌ ${error.message}</p>`;
                } finally {
                    loading.style.display = 'none';
                }
            }

            // Display recipient information
            function displayRecipient(recipient) {
                recipientName.textContent = recipient.name || 'N/A';
                recipientUsername.textContent = recipient.username;
                recipientAccount.textContent = recipient.account_number;
                recipientStatus.textContent = recipient.is_active ? 'Active' : 'Inactive';
                
                scanResult.style.display = 'block';
                scanStatus.className = 'scan-status success';
                scanStatus.innerHTML = '<p>✅ Recipient found successfully!</p>';
            }



            // Send payment
            function sendPayment() {
                if (currentRecipient) {
                    // Redirect to payment page with recipient account number pre-filled
                    window.location.href = `/?recipient_account=${currentRecipient.account_number}`;
                }
            }


            // Upload and process QR code from file
            function uploadQRCode() {
                console.log('📷 Upload QR code button clicked');
                qrFileInput.click();
            }

            // Handle drag and drop for QR code upload
            function setupDragAndDrop() {
                const scanContainer = document.querySelector('.scan-container');
                
                // Prevent default drag behaviors
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    scanContainer.addEventListener(eventName, preventDefaults, false);
                    document.body.addEventListener(eventName, preventDefaults, false);
                });

                // Highlight drop area when item is dragged over it
                ['dragenter', 'dragover'].forEach(eventName => {
                    scanContainer.addEventListener(eventName, highlight, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    scanContainer.addEventListener(eventName, unhighlight, false);
                });

                // Handle dropped files
                scanContainer.addEventListener('drop', handleDrop, false);

                function preventDefaults(e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                function highlight(e) {
                    scanContainer.classList.add('dragover');
                }

                function unhighlight(e) {
                    scanContainer.classList.remove('dragover');
                }

                function handleDrop(e) {
                    const dt = e.dataTransfer;
                    const files = dt.files;

                    if (files.length > 0) {
                        const file = files[0];
                        if (file.type.startsWith('image/')) {
                            console.log('📷 File dropped:', file.name);
                            processUploadedQRCode(file);
                        } else {
                            scanStatus.className = 'scan-status error';
                            scanStatus.innerHTML = '<p>❌ Please drop an image file (PNG, JPG, etc.)</p>';
                        }
                    }
                }
            }

            // Process uploaded QR code image
            async function processUploadedQRCode(file) {
                try {
                    console.log('📷 Processing uploaded QR code image:', file.name);
                    
                    // Show loading
                    loading.style.display = 'block';
                    scanStatus.className = 'scan-status';
                    scanStatus.innerHTML = '<p>🔄 Processing uploaded QR code...</p>';

                    // Create image element to load the file
                    const img = new Image();
                    const canvas = document.createElement('canvas');
                    const context = canvas.getContext('2d');

                    // Load image
                    img.onload = async function() {
                        try {
                            // Set canvas dimensions to match image
                            canvas.width = img.width;
                            canvas.height = img.height;
                            
                            // Draw image on canvas
                            context.drawImage(img, 0, 0);
                            
                            // Get image data
                            const imageData = context.getImageData(0, 0, canvas.width, canvas.height);
                            
                            // Use jsQR to decode the QR code
                            const code = jsQR(imageData.data, imageData.width, imageData.height);
                            
                            if (code) {
                                console.log('✅ QR code detected in uploaded image:', code.data);
                                scanStatus.className = 'scan-status success';
                                scanStatus.innerHTML = '<p>✅ QR code detected! Processing...</p>';
                                
                                // Process the QR code data
                                await handleQRResult(code.data);
                            } else {
                                throw new Error('No QR code found in the uploaded image');
                            }
                        } catch (error) {
                            console.error('Error processing QR code from image:', error);
                            scanStatus.className = 'scan-status error';
                            scanStatus.innerHTML = `<p>❌ ${error.message}</p>`;
                        } finally {
                            loading.style.display = 'none';
                        }
                    };

                    img.onerror = function() {
                        console.error('Error loading uploaded image');
                        scanStatus.className = 'scan-status error';
                        scanStatus.innerHTML = '<p>❌ Error loading uploaded image. Please try a different file.</p>';
                        loading.style.display = 'none';
                    };

                    // Load the image
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                } catch (error) {
                    console.error('Error in processUploadedQRCode:', error);
                    scanStatus.className = 'scan-status error';
                    scanStatus.innerHTML = '<p>❌ Error processing uploaded QR code.</p>';
                    loading.style.display = 'none';
                }
            }

            // Event listeners
            captureBtn.addEventListener('click', captureQRCode);
            uploadQrBtn.addEventListener('click', uploadQRCode);
            qrFileInput.addEventListener('change', (event) => {
                const file = event.target.files[0];
                if (file) {
                    processUploadedQRCode(file);
                }
            });
            sendPaymentBtn.addEventListener('click', sendPayment);
            scanAnotherBtn.addEventListener('click', () => {
                scanResult.style.display = 'none';
                scanStatus.className = 'scan-status scanning';
                scanStatus.innerHTML = '<p>📷 Camera ready - Click "Capture QR Code" to take a photo</p>';
            });

            // Initialize camera for capture mode
            initCamera();
            
            // Setup drag and drop
            setupDragAndDrop();
        });
    </script>

    <!-- Navigation JavaScript -->
    <script src="/js/floatingNav.js"></script>
</body>
</html>
