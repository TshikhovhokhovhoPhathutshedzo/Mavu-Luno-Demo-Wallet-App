  function setupPatternCanvas() {
    patternCtx.strokeStyle = '#1a73e8';
    patternCtx.lineWidth = 3;
    patternCtx.lineCap = 'round';
    patternCtx.lineJoin = 'round';
    
    patternCanvas.addEventListener('mousedown', startDrawing);
    patternCanvas.addEventListener('mousemove', draw);
    patternCanvas.addEventListener('mouseup', stopDrawing);
    patternCanvas.addEventListener('touchstart', handleTouch);
    patternCanvas.addEventListener('touchmove', handleTouch);
    patternCanvas.addEventListener('touchend', stopDrawing);
  }

  function startDrawing(e) {
    isDrawing = true;
    const point = getCanvasPoint(e);
    currentPattern = [point];
    patternCtx.beginPath();
    patternCtx.moveTo(point.x, point.y);
  }

  function draw(e) {
    if (!isDrawing) return;
    const point = getCanvasPoint(e);
    currentPattern.push(point);
    patternCtx.lineTo(point.x, point.y);
    patternCtx.stroke();
  }

  function stopDrawing() {
    isDrawing = false;
    if (currentPattern.length > 0) {
      patternAttempts.push([...currentPattern]);
      updatePatternProgress();
    }
  }

  function handleTouch(e) {
    e.preventDefault();
    if (e.type === 'touchstart') {
      startDrawing(e.touches[0]);
    } else if (e.type === 'touchmove') {
      draw(e.touches[0]);
    }
  }

  function getCanvasPoint(e) {
    const rect = patternCanvas.getBoundingClientRect();
    return {
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
      timestamp: Date.now(),
      pressure: e.pressure || 0.5
    };
  }

  function calculatePatternTiming(pattern) {
    const timings = [];
    for (let i = 1; i < pattern.length; i++) {
      timings.push(pattern[i].timestamp - pattern[i-1].timestamp);
    }
    return timings;
  }

  function updatePatternProgress() {
    document.getElementById('pattern-attempt-count').textContent = patternAttempts.length;
    document.getElementById('pattern-total-attempts').textContent = '3';
    
