  const faceBtn = document.getElementById('edit-face-btn');
  const patternBtn = document.getElementById('edit-pattern-btn');
  const profileBtn = document.getElementById('edit-profile-btn');
  const passwordBtn = document.getElementById('edit-password-btn');
  
  console.log('🔧 Button elements found:', {
    security: !!securityBtn,
