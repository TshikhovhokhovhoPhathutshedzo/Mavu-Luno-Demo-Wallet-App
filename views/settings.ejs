<%- include("partials/head") %>
<body>
    <main class="main">
        <section class="main-card">
            <div class="main-card-top">
                <!-- heading -->
                <header class="user-head">
                    <div class="user-head-left">
                        <div class="user-name">
                            <span>Settings</span>
                            <span class="date">Manage your account preferences</span>
                        </div>
                    </div>
                    <div class="user-head-right">
                        <a href="/" class="user-head-icon" role="button">
                            <i class="bi bi-house"></i>
                        </a>
                    </div>
                </header>
            </div>
            
            <div class="main-card-bottom">
                <!-- SECURITY SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Security</h3>
                            <p>Manage your security settings</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-security-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">2FA</span>
                            <span class="settings-value">Enabled</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Email Alerts</span>
                            <span class="settings-value">On</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Security Questions</span>
                            <span class="settings-value">Set</span>
                        </div>
                    </div>
                </div>
                <!-- NOTIFY SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-bell"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Notifications</h3>
                            <p>Manage your notification preferences</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-notify-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Push Notifications</span>
                            <span class="settings-value">Enabled</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">In-App Alerts</span>
                            <span class="settings-value">On</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Email Notifications</span>
                            <span class="settings-value">Active</span>
                        </div>
                    </div>
                </div>
                <!-- APPEARANCE / THEME SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-moon-stars"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Appearance</h3>
                            <p>Switch between light and dark mode</p>
                        </div>
                        <div class="settings-edit-btn" style="display:flex; align-items:center; gap:8px;">
                            <label class="switch">
                                <input type="checkbox" id="theme-toggle">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Theme</span>
                            <span class="settings-value" id="theme-label">Light</span>
                        </div>
                    </div>
                </div>
                <!-- FACE LOGIN SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-camera"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Face Recognition</h3>
                            <p>Set up face login for quick access</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-face-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Face Login</span>
                            <span class="settings-value" id="face-status">Not Set</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Face Auth Status</span>
                            <span class="settings-value" id="face-auth-status">Checking...</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Last Updated</span>
                            <span class="settings-value" id="face-last-updated">Never</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Security Level</span>
                            <span class="settings-value">High</span>
                        </div>
                    </div>
                </div>
                <!-- BEHAVIORAL BIOMETRICS SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-fingerprint"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Behavioral Biometrics</h3>
                            <p>Pattern authentication for enhanced security</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-pattern-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Pattern Login</span>
                            <span class="settings-value" id="pattern-status">Not Set</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Pattern Type</span>
                            <span class="settings-value" id="pattern-type">None</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Learning Status</span>
                            <span class="settings-value">Inactive</span>
                        </div>
                    </div>
                </div>
                <!-- PROFILE SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Profile</h3>
                            <p>Manage your personal information</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-profile-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Email</span>
                            <span class="settings-value"><%- user.email ? user.email.replace(/[<>]/g, '') : '' %></span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Username</span>
                            <span class="settings-value"><%- user.username ? user.username.replace(/[<>]/g, '') : '' %></span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Account Number</span>
                            <span class="settings-value"><%- user.account_number || 'Not assigned' %></span>
                        </div>
                    </div>
                </div>
    
                <!-- PASSWORD SECTION -->
                <div class="settings-card">
                    <div class="settings-header">
                        <div class="settings-icon">
                            <i class="bi bi-key"></i>
                        </div>
                        <div class="settings-title">
                            <h3>Password</h3>
                            <p>Manage your account password</p>
                        </div>
                        <button class="settings-edit-btn" id="edit-password-btn">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                    <div class="settings-content">
                        <div class="settings-item">
                            <span class="settings-label">Password</span>
                            <span class="settings-value">••••••••</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Last Changed</span>
                            <span class="settings-value" id="password-last-changed">Never</span>
                        </div>
                        <div class="settings-item">
                            <span class="settings-label">Strength</span>
                            <span class="settings-value">Strong</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
  </section>
</main>
<!-- Modals -->
<div id="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.35); z-index:9999;"></div>
<div id="security-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-shield-lock"></i></span>
    <div class="modern-modal-title">Edit Security Settings</div>
    <div class="modern-modal-subtitle">Update your security preferences below.</div>
    <form>
      <div class="modern-modal-group">
        <label class="modern-modal-label">2FA</label>
        <div class="modern-modal-radio-group">
          <label class="modern-radio"><input type="radio" name="2fa" checked> Enabled</label>
          <label class="modern-radio"><input type="radio" name="2fa"> Disabled</label>
        </div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Email Alerts</label>
        <div class="modern-modal-radio-group">
          <label class="modern-radio"><input type="radio" name="email_alerts" checked> On</label>
          <label class="modern-radio"><input type="radio" name="email_alerts"> Off</label>
        </div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Security Question 1</label>
        <select class="modern-modal-input" name="security_question_1">
          <option value="pet">What is the name of your first pet?</option>
          <option value="school">What was the name of your primary school?</option>
          <option value="city">In what city were you born?</option>
          <option value="mother">What is your mother's maiden name?</option>
          <option value="car">What was your first car?</option>
        </select>
        <input type="text" class="modern-modal-input" name="security_answer_1" placeholder="Your answer">
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Security Question 2</label>
        <select class="modern-modal-input" name="security_question_2">
          <option value="pet">What is the name of your first pet?</option>
          <option value="school">What was the name of your primary school?</option>
          <option value="city">In what city were you born?</option>
          <option value="mother">What is your mother's maiden name?</option>
          <option value="car">What was your first car?</option>
        </select>
        <input type="text" class="modern-modal-input" name="security_answer_2" placeholder="Your answer">
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Security Question 3</label>
        <select class="modern-modal-input" name="security_question_3">
          <option value="pet">What is the name of your first pet?</option>
          <option value="school">What was the name of your primary school?</option>
          <option value="city">In what city were you born?</option>
          <option value="mother">What is your mother's maiden name?</option>
          <option value="car">What was your first car?</option>
        </select>
        <input type="text" class="modern-modal-input" name="security_answer_3" placeholder="Your answer">
      </div>
      <button type="submit" class="modern-modal-btn">Save</button>
      <div class="modern-modal-cancel" onclick="closeModal()">Cancel</div>
    </form>
  </div>
</div>
<div id="notify-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-bell"></i></span>
    <div class="modern-modal-title">Edit Notification Settings</div>
    <div class="modern-modal-subtitle">Manage your notification preferences.</div>
    <form>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Push Notifications</label>
        <div class="modern-modal-radio-group">
          <label class="modern-radio"><input type="radio" name="push" checked> Enabled</label>
          <label class="modern-radio"><input type="radio" name="push"> Disabled</label>
        </div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">In-App Alerts</label>
        <div class="modern-modal-radio-group">
          <label class="modern-radio"><input type="radio" name="inapp" checked> On</label>
          <label class="modern-radio"><input type="radio" name="inapp"> Off</label>
        </div>
      </div>
      <button type="submit" class="modern-modal-btn">Save</button>
      <div class="modern-modal-cancel" onclick="closeModal()">Cancel</div>
    </form>
  </div>
</div>
<div id="profile-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-person-circle"></i></span>
    <div class="modern-modal-title">Edit Profile</div>
    <div class="modern-modal-subtitle">Update your profile information.</div>
    <form>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Email</label>
        <input type="email" class="modern-modal-input" id="profile-email" value="<%- user.email ? user.email.replace(/[<>]/g, '') : '' %>" autocomplete="email">
        <div id="email-error" class="input-error" style="color:#dc3545; font-size:0.9em; display:none;"></div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Username</label>
        <input type="text" class="modern-modal-input" id="profile-username" value="<%- user.username ? user.username.replace(/[<>]/g, '') : '' %>" autocomplete="username">
        <div id="username-error" class="input-error" style="color:#dc3545; font-size:0.9em; display:none;"></div>
      </div>
      <button type="submit" class="modern-modal-btn" id="profile-save-btn" disabled>Save</button>
      <div class="modern-modal-cancel" onclick="closeModal()">Cancel</div>
    </form>
  </div>
</div>

<!-- Password Change Modal -->
<div id="password-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-key"></i></span>
    <div class="modern-modal-title">Change Password</div>
    <div class="modern-modal-subtitle">Update your account password securely.</div>
    <form id="password-form">
      <div class="modern-modal-group">
        <label class="modern-modal-label">Current Password</label>
        <input type="password" class="modern-modal-input" id="current-password" name="currentPassword" required>
        <div id="current-password-error" class="input-error" style="color:#dc3545; font-size:0.9em; display:none;"></div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">New Password</label>
        <input type="password" class="modern-modal-input" id="new-password" name="newPassword" required>
        <div id="new-password-error" class="input-error" style="color:#dc3545; font-size:0.9em; display:none;"></div>
        <div id="password-strength" style="margin-top: 8px; font-size: 0.9em;"></div>
      </div>
      <div class="modern-modal-group">
        <label class="modern-modal-label">Confirm New Password</label>
        <input type="password" class="modern-modal-input" id="confirm-password" name="confirmPassword" required>
        <div id="confirm-password-error" class="input-error" style="color:#dc3545; font-size:0.9em; display:none;"></div>
      </div>
      <button type="submit" class="modern-modal-btn" id="password-save-btn">Change Password</button>
      <div class="modern-modal-cancel" onclick="closeModal()">Cancel</div>
    </form>
  </div>
</div>

<!-- Face Login Modal -->
<div id="face-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-camera"></i></span>
    <div class="modern-modal-title">Face Login Setup</div>
    <div class="modern-modal-subtitle">Enroll your face for secure biometric authentication</div>
    
    <!-- Step 1: Instructions -->
    <div id="face-step-1" class="face-step">
      <div class="face-instructions">
        <h4>📸 How it works:</h4>
        <ul>
          <li>Take 3-5 photos of your face from different angles</li>
          <li>Ensure good lighting and clear visibility</li>
          <li>Remove glasses, hats, or face coverings</li>
          <li>Look directly at the camera</li>
        </ul>
        <div class="face-status-info">
          <span id="face-current-status">Status: Not enrolled</span>
        </div>
        <div class="face-help-info" style="margin-top: 15px; padding: 10px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #ffc107;">
          <h5 style="margin: 0 0 8px 0; color: #856404;">🔧 Troubleshooting:</h5>
          <p style="margin: 0; font-size: 0.9em; color: #666;">If face enrollment doesn't work, click "Test Service" to check if the face recognition service is running. If not, run the microservice first.</p>
        </div>
      </div>
      <div class="face-actions">
        <button id="face-enroll-btn" class="modern-modal-btn">Start Enrollment</button>
        <button id="face-delete-btn" class="modern-modal-btn" style="background:#dc3545; display:none;">Delete Face Data</button>
        <button id="face-test-microservice-btn" class="modern-modal-btn-secondary" style="font-size:0.9em;">Test Service</button>
        <button id="face-cancel-btn" class="modern-modal-btn-secondary">Cancel</button>
      </div>
    </div>

    <!-- Step 2: Camera Capture -->
    <div id="face-step-2" class="face-step" style="display:none;">
      <div class="face-camera-container">
        <video id="face-video" width="320" height="240" autoplay muted style="border-radius:12px; background:#222; width:100%; max-width:320px;"></video>
        <canvas id="face-canvas" style="display:none;"></canvas>
      </div>
      <div class="face-capture-info">
        <p id="face-capture-text">Position your face in the camera and click "Capture"</p>
        <div id="face-capture-progress">
          <span id="face-captured-count">0</span> / <span id="face-total-needed">5</span> photos captured
        </div>
      </div>
      <div class="face-actions">
        <button id="face-capture-btn" class="modern-modal-btn">Capture Photo</button>
        <button id="face-finish-btn" class="modern-modal-btn" style="display:none;">Finish Enrollment</button>
        <button id="face-back-btn" class="modern-modal-btn-secondary">Back</button>
      </div>
    </div>

    <!-- Step 3: Processing -->
    <div id="face-step-3" class="face-step" style="display:none;">
      <div class="face-processing">
        <div class="spinner"></div>
        <p>Processing your face data...</p>
        <p id="face-processing-text">Creating secure biometric template</p>
      </div>
    </div>

    <!-- Error Display -->
    <div id="face-error" style="color:#dc3545; font-size:0.95em; margin:10px 0; display:none;"></div>
  </div>
</div>

<!-- Behavioral Biometrics Modal -->
<div id="pattern-modal" class="modern-modal" style="display:none;">
  <div class="modern-modal-content">
    <span class="modern-modal-icon"><i class="bi bi-fingerprint"></i></span>
    <div class="modern-modal-title">Behavioral Biometrics Setup</div>
    <div class="modern-modal-subtitle">Create a secure pattern for authentication</div>
    
    <!-- Error Display -->
    <div id="pattern-error" style="color:#dc3545; font-size:0.95em; margin:10px 0; display:none;"></div>
    
    <!-- Step 1: Pattern Type Selection -->
    <div id="pattern-step-1" class="pattern-step">
      <div class="pattern-instructions">
        <h4>🎯 Choose Pattern Type:</h4>
        <div class="pattern-type-grid">
          <div class="pattern-type-option" data-type="swipe">
            <div class="pattern-type-icon">👆</div>
            <div class="pattern-type-name">Swipe Pattern</div>
            <div class="pattern-type-desc">Draw a pattern by swiping</div>
          </div>
          <div class="pattern-type-option" data-type="tap">
            <div class="pattern-type-icon">👆</div>
            <div class="pattern-type-name">Tap Pattern</div>
            <div class="pattern-type-desc">Tap specific points</div>
          </div>
          <div class="pattern-type-option" data-type="draw">
            <div class="pattern-type-icon">✏️</div>
            <div class="pattern-type-name">Draw Pattern</div>
            <div class="pattern-type-desc">Draw a shape or symbol</div>
          </div>
          <div class="pattern-type-option" data-type="gesture">
            <div class="pattern-type-icon">🤚</div>
            <div class="pattern-type-name">Gesture Pattern</div>
            <div class="pattern-type-desc">Use hand gestures</div>
          </div>
          <div class="pattern-type-option" data-type="typing">
            <div class="pattern-type-icon">⌨️</div>
            <div class="pattern-type-name">Typing Pattern</div>
            <div class="pattern-type-desc">Type with rhythm</div>
          </div>
        </div>
        <div class="pattern-status-info">
          <span id="pattern-current-status">Status: Not set</span>
        </div>
      </div>
      <div class="pattern-actions">
        <button id="pattern-setup-btn" class="modern-modal-btn" style="display:none;">Setup Pattern</button>
        <button id="pattern-delete-btn" class="modern-modal-btn" style="background:#dc3545; display:none;">Delete Pattern</button>
        <button id="pattern-cancel-btn" class="modern-modal-btn-secondary">Cancel</button>
      </div>
    </div>

    <!-- Step 2: Pattern Setup -->
    <div id="pattern-step-2" class="pattern-step" style="display:none;">
      <div class="pattern-setup-container">
        <div class="pattern-canvas-container">
          <canvas id="pattern-canvas" width="300" height="300" style="border:2px solid #1a73e8; border-radius:8px; background:#f8f9fa;"></canvas>
          <div class="pattern-canvas-overlay" id="pattern-canvas-overlay">
            <div class="pattern-instruction-text">Draw your pattern here</div>
          </div>
        </div>
        <div class="pattern-setup-info">
          <p id="pattern-setup-text">Draw your pattern 3 times to complete setup</p>
          <div id="pattern-setup-progress">
            <span id="pattern-attempt-count">0</span> / <span id="pattern-total-attempts">3</span> attempts
          </div>
          <div class="pattern-similarity-info" id="pattern-similarity" style="display:none;">
            <span>Similarity: <span id="pattern-similarity-score">0%</span></span>
          </div>
        </div>
      </div>
      <div class="pattern-actions">
        <button id="pattern-clear-btn" class="modern-modal-btn-secondary">Clear</button>
        <button id="pattern-submit-btn" class="modern-modal-btn">Submit Pattern</button>
        <button id="pattern-back-btn" class="modern-modal-btn-secondary">Back</button>
      </div>
    </div>

    <!-- Step 3: Pattern Verification -->
    <div id="pattern-step-3" class="pattern-step" style="display:none;">
      <div class="pattern-verification-container">
        <div class="pattern-canvas-container">
          <canvas id="pattern-verify-canvas" width="300" height="300" style="border:2px solid #1a73e8; border-radius:8px; background:#f8f9fa;"></canvas>
          <div class="pattern-canvas-overlay" id="pattern-verify-overlay">
            <div class="pattern-instruction-text">Draw your pattern to verify</div>
          </div>
        </div>
        <div class="pattern-verification-info">
          <p id="pattern-verify-text">Draw your pattern to test verification</p>
          <div class="pattern-similarity-info">
            <span>Similarity: <span id="pattern-verify-similarity">0%</span></span>
          </div>
        </div>
      </div>
      <div class="pattern-actions">
        <button id="pattern-verify-btn" class="modern-modal-btn">Test Verification</button>
        <button id="pattern-verify-back-btn" class="modern-modal-btn-secondary">Back</button>
      </div>
    </div>

    <!-- Step 4: Processing -->
    <div id="pattern-step-4" class="pattern-step" style="display:none;">
      <div class="pattern-processing">
        <div class="spinner"></div>
        <p>Processing your pattern...</p>
        <p id="pattern-processing-text">Creating secure biometric template</p>
      </div>
    </div>

    <!-- Error Display -->
    <div id="pattern-error" style="color:#dc3545; font-size:0.95em; margin:10px 0; display:none;"></div>
  </div>
</div>

<style>
/* Toggle switch */
.switch { position: relative; display: inline-block; width: 48px; height: 26px; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .2s; border-radius: 26px; }
.slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .2s; border-radius: 50%; }
input:checked + .slider { background-color: #2563eb; }
