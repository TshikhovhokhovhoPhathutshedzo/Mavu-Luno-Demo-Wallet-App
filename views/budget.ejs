<%- include("partials/head") %>
<style>
    /* Modern Budget Page Styles */
    .budget-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
    }

    .budget-header {
        text-align: center;
        margin-bottom: 40px;
        color: white;
    }

    .budget-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0 0 10px 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .budget-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
    }

    .budget-content {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 30px;
        margin-bottom: 30px;
    }

    .budget-form-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .budget-form-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 25px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 500;
        color: #374151;
        margin-bottom: 8px;
        font-size: 0.9rem;
    }

    .form-input {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: #f9fafb;
        box-sizing: border-box;
    }

    .form-input:focus {
        outline: none;
        border-color: #667eea;
        background: white;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .form-select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 1rem;
        background: #f9fafb;
        cursor: pointer;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-select:focus {
        outline: none;
        border-color: #667eea;
        background: white;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .add-budget-btn {
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 20px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .add-budget-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }

    .add-budget-btn:active {
        transform: translateY(0);
    }

    .budget-stats-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .stats-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 25px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 20px;
    }

    .stat-item {
        text-align: center;
        padding: 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 5px 0;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6b7280;
        margin: 0;
        font-weight: 500;
    }

    .budget-items-section {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .budget-items-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .budget-items-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .clear-all-btn {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .clear-all-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }

    .budget-item {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .budget-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .budget-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .budget-category {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
    }

    .category-info h4 {
        margin: 0 0 4px 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
    }

    .category-info p {
        margin: 0;
        font-size: 0.85rem;
        color: #6b7280;
    }

    .budget-actions {
        display: flex;
        gap: 10px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .edit-btn {
        background: #3b82f6;
        color: white;
    }

    .edit-btn:hover {
        background: #2563eb;
        transform: scale(1.1);
    }

    .delete-btn {
        background: #ef4444;
        color: white;
    }

    .delete-btn:hover {
        background: #dc2626;
        transform: scale(1.1);
    }

    .budget-progress {
        margin-bottom: 15px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .progress-label {
        font-size: 0.9rem;
        font-weight: 500;
        color: #374151;
    }

    .progress-percentage {
        font-size: 0.9rem;
        font-weight: 600;
        color: #1f2937;
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .progress-good {
        background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    }

    .progress-warning {
        background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
    }

    .progress-danger {
        background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
    }

    .budget-amounts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }

    .amount-item {
        text-align: center;
        padding: 12px;
        background: white;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
    }

    .amount-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 4px 0;
    }

    .amount-label {
        font-size: 0.8rem;
        color: #6b7280;
        margin: 0;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #374151;
        margin: 0 0 10px 0;
    }

    .empty-description {
        font-size: 1rem;
        margin: 0;
        opacity: 0.8;
    }

    .loading-spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 2px solid #f3f3f3;
        border-top: 2px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .slide-in {
        animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
        from { transform: translateX(-100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .budget-content {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        .budget-container {
            padding: 15px;
        }
        
        .budget-title {
            font-size: 2rem;
        }
        
        .budget-amounts {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<body>
    <div class="budget-container">
        <!-- Header -->
        <div class="budget-header">
            <h1 class="budget-title">💰 Budget Management</h1>
            <p class="budget-subtitle">Take control of your finances with smart budgeting</p>
        </div>

        <!-- Main Content -->
        <div class="budget-content">
            <!-- Add Budget Form -->
            <div class="budget-form-card fade-in">
                <h2 class="budget-form-title">
                    <i class="bi bi-plus-circle"></i>
                    Add New Budget
                </h2>
                <form id="budgetForm">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select id="categorySelect" class="form-select" required>
                            <option value="">Choose a category</option>
                        </select>
                        </div>
                    <div class="form-group">
                        <label class="form-label">Budget Amount (R)</label>
                        <input id="budgetAmount" type="number" class="form-input" placeholder="Enter amount" min="1" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Period</label>
                        <select id="periodType" class="form-select" required>
                            <option value="monthly">Monthly</option>
                            <option value="weekly">Weekly</option>
                            <option value="yearly">Yearly</option>
                        </select>
                    </div>
                    <button type="submit" id="addBudgetBtn" class="add-budget-btn">
                        <i class="bi bi-plus-circle"></i>
                        Add Budget Item
                    </button>
                </form>
            </div>

            <!-- Budget Stats -->
            <div class="budget-stats-card fade-in">
                <h2 class="stats-title">
                    <i class="bi bi-graph-up"></i>
                    Overview
                </h2>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value" id="totalBudgets">0</div>
                        <div class="stat-label">Total Budgets</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="totalAmount">R0</div>
                        <div class="stat-label">Total Amount</div>
                        </div>
                    <div class="stat-item">
                        <div class="stat-value" id="totalSpent">R0</div>
                        <div class="stat-label">Total Spent</div>
                        </div>
                    <div class="stat-item">
                        <div class="stat-value" id="remainingAmount">R0</div>
                        <div class="stat-label">Remaining</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Budget Items Section -->
        <div class="budget-items-section fade-in">
            <div class="budget-items-header">
                <h2 class="budget-items-title">
                    <i class="bi bi-list-ul"></i>
                    Your Budget Items
                </h2>
                <button id="clearAllBudgetsBtn" class="clear-all-btn">
                    <i class="bi bi-trash"></i>
                    Clear All
                </button>
            </div>
            
            <div id="budgetItemsList" class="budget-items-list">
                <!-- Budget items will be dynamically loaded here -->
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="empty-state" style="display:none;">
                <div class="empty-icon">📊</div>
                <h3 class="empty-title">No budget items yet</h3>
                <p class="empty-description">Create your first budget item to start tracking your spending and take control of your finances.</p>
            </div>
        </div>
    </div>

    <%- include("partials/floating-nav") %>
    <script src="/js/floatingNav.js"></script>
    <script>
        // Global variables
        let budgetItems = [];
        let categories = [];

        // DOM elements
        const categorySelect = document.getElementById('categorySelect');
        const budgetAmount = document.getElementById('budgetAmount');
        const periodType = document.getElementById('periodType');
        const addBudgetBtn = document.getElementById('addBudgetBtn');
        const clearAllBtn = document.getElementById('clearAllBudgetsBtn');
        const budgetItemsList = document.getElementById('budgetItemsList');
        const emptyState = document.getElementById('emptyState');

        // Stats elements
        const totalBudgetsEl = document.getElementById('totalBudgets');
        const totalAmountEl = document.getElementById('totalAmount');
        const totalSpentEl = document.getElementById('totalSpent');
        const remainingAmountEl = document.getElementById('remainingAmount');

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            loadCategories();
            loadBudgetItems();
            setupEventListeners();
        });

        // Load available categories
        async function loadCategories() {
            try {
                const response = await fetch('/budget/api/categories');
                const data = await response.json();
                
                if (data.success) {
                    categories = data.categories;
                    populateCategorySelect();
                } else {
                    console.error('Failed to load categories:', data.message);
                }
            } catch (error) {
                console.error('Error loading categories:', error);
            }
        }

        // Populate category select dropdown
        function populateCategorySelect() {
            categorySelect.innerHTML = '<option value="">Choose a category</option>';
            categories.forEach(category => {
                const option = document.createElement('option');
                option.value = category.category_id;
                option.textContent = category.category_name;
                categorySelect.appendChild(option);
            });
        }

        // Load budget items
        async function loadBudgetItems() {
            try {
                const response = await fetch('/budget/api/budgets');
                const data = await response.json();
                
                if (data.success) {
                    budgetItems = data.budgetItems || [];
                    renderBudgetItems();
                    updateStats();
                } else {
                    console.error('Failed to load budget items:', data.message);
                }
            } catch (error) {
                console.error('Error loading budget items:', error);
            }
        }

        // Render budget items
        function renderBudgetItems() {
            if (budgetItems.length === 0) {
                budgetItemsList.innerHTML = '';
                emptyState.style.display = 'block';
                return;
            }

            emptyState.style.display = 'none';
            budgetItemsList.innerHTML = '';

            budgetItems.forEach((item, index) => {
                const budgetItem = createBudgetItemElement(item, index);
                budgetItemsList.appendChild(budgetItem);
            });
        }

        // Create budget item element
        function createBudgetItemElement(item, index) {
            const div = document.createElement('div');
            div.className = 'budget-item slide-in';
            div.style.animationDelay = `${index * 0.1}s`;

            // Use category data directly from the budget item (from SQL function)
            const categoryName = item.category_name || 'Unknown Category';
            const categoryIcon = item.category_icon || '📊';
            const categoryColor = item.category_color || '#6b7280';
            
            const usagePercentage = parseFloat(item.usage_percentage) || 0;
            const progressClass = usagePercentage >= 100 ? 'progress-danger' : 
                                usagePercentage >= 80 ? 'progress-warning' : 'progress-good';

            div.innerHTML = `
                <div class="budget-item-header">
                    <div class="budget-category">
                        <div class="category-icon" style="background-color: ${categoryColor};">
                            ${categoryIcon}
                        </div>
                        <div class="category-info">
                            <h4>${categoryName}</h4>
                            <p>${item.period_type.charAt(0).toUpperCase() + item.period_type.slice(1)} Budget</p>
                        </div>
                    </div>
                    <div class="budget-actions">
                        <button class="action-btn edit-btn" onclick="editBudgetItem('${item.budget_id}')" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="action-btn delete-btn" onclick="deleteBudgetItem('${item.budget_id}')" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                
                <div class="budget-progress">
                    <div class="progress-header">
                        <span class="progress-label">Progress</span>
                        <span class="progress-percentage">${usagePercentage.toFixed(1)}%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill ${progressClass}" style="width: ${Math.min(usagePercentage, 100)}%"></div>
                    </div>
                </div>
                
                <div class="budget-amounts">
                    <div class="amount-item">
                        <div class="amount-value">R${parseFloat(item.budget_amount_rands).toFixed(2)}</div>
                        <div class="amount-label">Budget</div>
                    </div>
                    <div class="amount-item">
                        <div class="amount-value">R${parseFloat(item.usage_amount_rands).toFixed(2)}</div>
                        <div class="amount-label">Spent</div>
                    </div>
                    <div class="amount-item">
                        <div class="amount-value">R${parseFloat(item.remaining_amount_rands).toFixed(2)}</div>
                        <div class="amount-label">Remaining</div>
                    </div>
                </div>
            `;

            return div;
        }

        // Update statistics
        function updateStats() {
            const totalBudgets = budgetItems.length;
            const totalAmount = budgetItems.reduce((sum, item) => sum + parseFloat(item.budget_amount_rands), 0);
            const totalSpent = budgetItems.reduce((sum, item) => sum + parseFloat(item.usage_amount_rands), 0);
            const remainingAmount = totalAmount - totalSpent;

            totalBudgetsEl.textContent = totalBudgets;
            totalAmountEl.textContent = `R${totalAmount.toFixed(2)}`;
            totalSpentEl.textContent = `R${totalSpent.toFixed(2)}`;
            remainingAmountEl.textContent = `R${remainingAmount.toFixed(2)}`;
        }

        // Setup event listeners
        function setupEventListeners() {
            // Form submission
            document.getElementById('budgetForm').addEventListener('submit', handleAddBudget);
            
            // Clear all button
            clearAllBtn.addEventListener('click', handleClearAll);
        }

        // Handle add budget
        async function handleAddBudget(e) {
            e.preventDefault();
            
            const categoryId = categorySelect.value;
            const amount = budgetAmount.value;
            const period = periodType.value;

            if (!categoryId || !amount) {
                alert('Please fill in all fields');
                return;
            }

            // Show loading state
            addBudgetBtn.innerHTML = '<div class="loading-spinner"></div> Adding...';
            addBudgetBtn.disabled = true;

            try {
                const response = await fetch('/budget/api/budgets', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        categoryId,
                        budgetAmount: parseFloat(amount),
                        periodType: period
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Reset form
                    document.getElementById('budgetForm').reset();
                    
                    // Reload budget items
                    await loadBudgetItems();
                    
                    // Show success message
                    showNotification('Budget item added successfully!', 'success');
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                console.error('Error adding budget item:', error);
                alert('Failed to add budget item. Please try again.');
            } finally {
                // Reset button state
                addBudgetBtn.innerHTML = '<i class="bi bi-plus-circle"></i> Add Budget Item';
                addBudgetBtn.disabled = false;
            }
        }

        // Handle clear all
        async function handleClearAll() {
            if (budgetItems.length === 0) {
                alert('No budget items to clear');
                return;
            }

            if (!confirm('Are you sure you want to clear all budget items? This action cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch('/budget/api/budgets', {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    budgetItems = [];
                    renderBudgetItems();
                    updateStats();
                    showNotification('All budget items cleared successfully!', 'success');
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                console.error('Error clearing budget items:', error);
                alert('Failed to clear budget items. Please try again.');
            }
        }

        // Edit budget item
        function editBudgetItem(budgetId) {
            const item = budgetItems.find(item => item.budget_id === budgetId);
            if (!item) return;

            const newAmount = prompt('Enter new budget amount:', item.budget_amount_rands);
            if (newAmount === null || newAmount === '') return;

            const amount = parseFloat(newAmount);
            if (isNaN(amount) || amount <= 0) {
                alert('Please enter a valid amount');
                return;
            }

            updateBudgetItem(budgetId, amount);
        }

        // Update budget item
        async function updateBudgetItem(budgetId, amount) {
            try {
                const response = await fetch(`/budget/api/budgets/${budgetId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        budgetAmount: amount
                    })
                });

                const data = await response.json();

                if (data.success) {
                    await loadBudgetItems();
                    showNotification('Budget item updated successfully!', 'success');
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                console.error('Error updating budget item:', error);
                alert('Failed to update budget item. Please try again.');
            }
        }

        // Delete budget item
        async function deleteBudgetItem(budgetId) {
            if (!confirm('Are you sure you want to delete this budget item?')) {
                return;
            }

            try {
                const response = await fetch(`/budget/api/budgets/${budgetId}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    await loadBudgetItems();
                    showNotification('Budget item deleted successfully!', 'success');
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                console.error('Error deleting budget item:', error);
                alert('Failed to delete budget item. Please try again.');
            }
        }

        // Show notification
        function showNotification(message, type = 'info') {
            // Create notification element
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#3b82f6'};
                color: white;
                padding: 15px 20px;
                border-radius: 10px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
                z-index: 1000;
                font-weight: 500;
                animation: slideIn 0.3s ease-out;
            `;
            notification.textContent = message;

            document.body.appendChild(notification);

            // Remove after 3 seconds
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease-in';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }, 3000);
        }

        // Add slideOut animation
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>